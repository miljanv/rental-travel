# Kontakt forma — slanje mejla preko SMTP-a (bez eksternih servisa).
# Bez ovih promenljivih forma prikazuje poruku da se korisnik obrati telefonom.
#
# Gmail:     SMTP_HOST=smtp.gmail.com, SMTP_USER=vasa@gmail.com,
#            SMTP_PASSWORD = 16-cifreni "App password" (zahteva uključen 2FA)
# Hostinger: SMTP_HOST=smtp.hostinger.com, SMTP_USER=office@rentaltravel.rs,
#            SMTP_PASSWORD = lozinka tog sandučeta
#
# Pošiljalac je uvek SMTP_USER, jer serveri odbijaju tuđu adresu u "From".
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=

# Opciono — primalac upita. Podrazumevano je kontakt adresa sa sajta.
# CONTACT_TO_EMAIL=rentaltraveldoo@gmail.com
